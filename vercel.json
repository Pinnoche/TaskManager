{
    "builds": [
      { "src": "api/index.php", "use": "@vercel/php" },
      { "src": "resources/js/app.js", "use": "@vercel/node" }
    ],
    "routes": [
      { "src": "/(.*)", "dest": "/public/index.php" }
    ],
    "env": {
      "APP_ENV": "production"
    },
    "buildCommand": "composer install && npm install && npm run build"
  }
  