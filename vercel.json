{
    "builds": [
      { "src": "api/index.php", "use": "@vercel/php" },
      { "src": "resources/js/app.js", "use": "@vercel/node" }
    ],
    "rewrites": [
      { "source": "/(.*)", "destination": "/" }
    ],
    "env": {
      "APP_ENV": "production"
    },
    "buildCommand": "composer install && npm run build"
  }
  